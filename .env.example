# Copia este archivo a .env y cambia los valores

# Contraseña de la base de datos (la misma que DATABASE_URL)
POSTGRES_PASSWORD=cambia-esta-clave-larga

DATABASE_URL=postgres://barrio:cambia-esta-clave-larga@db:5432/barrio

# Dirección pública con la que se abre la app (la que se usa en los enlaces del correo)
APP_URL=https://tu-dominio.com

# Emails de los organizadores (separados por comas)
ADMIN_EMAILS=tu@correo.com

# Servidor de correo para enviar la confirmación
SMTP_HOST=smtp.tu-proveedor.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=usuario-smtp
SMTP_PASS=contraseña-smtp
SMTP_FROM=Barrio de Fantasía <no-reply@tu-dominio.com>
